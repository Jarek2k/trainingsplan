PORT=5173

# Komma-separierte Liste der Google-Mail-Adressen für den initialen Seed der
# Allowlist (alle als Admin). Nach dem ersten Server-Start steht die Liste in
# server/data/allowlist.json und wird über das "Zugriff verwalten"-Modal im
# Profilmenü gepflegt — diese Variable hat danach keinen Effekt mehr.
ALLOWED_EMAILS=

# Aus der Google Cloud Console (OAuth 2.0 Client ID, Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# 32+ Bytes zufälliger Hex-String. Z. B.: openssl rand -hex 32
SESSION_SECRET=

# Auf "false" setzen für lokale Entwicklung ohne HTTPS, sonst weglassen.
COOKIE_SECURE=false
